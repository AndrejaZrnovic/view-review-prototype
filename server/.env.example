# Copy this file to server/.env and fill in ONE of the keys, then restart the server.

# Recommended: fal.ai key (https://fal.ai/dashboard/keys). About $0.035 per megapixel (~$0.04 per 1024x1024 view).
FAL_KEY=

# Free alternative: Hugging Face access token (https://huggingface.co/settings/tokens, "Read" is enough).
# Uses a public ZeroGPU Space with the same model; the free daily GPU quota covers only a few views.
HF_TOKEN=

# Optional overrides
# PROVIDER=fal            # fal | hf | mock (default: fal if FAL_KEY, else hf if HF_TOKEN, else mock)
# PORT=8787
# FAL_MODEL=fal-ai/qwen-image-edit-2511-multiple-angles
# HF_SPACE=multimodalart/qwen-image-multiple-angles-3d-camera
