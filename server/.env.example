# Copy this file to server/.env, choose a provider, then restart the server.
# Never put real keys in this file: it is committed. server/.env is git-ignored.

# Free: run the model on this computer (after `bash server/setup-local.sh`).
# PROVIDER=local
# LOCAL_MEGAPIXELS=0.6

# Recommended: fal.ai key (https://fal.ai/dashboard/keys). About $0.035 per megapixel (~$0.04 per 1024x1024 view).
FAL_KEY=

# Free alternative: Hugging Face access token (https://huggingface.co/settings/tokens, "Read" is enough).
# Uses a public ZeroGPU Space with the same model; the free daily GPU quota covers only a few views.
HF_TOKEN=

# Optional overrides
# PROVIDER=fal            # local | fal | hf | mock (default: fal if FAL_KEY, else local if installed, else hf if HF_TOKEN, else mock)
# PORT=8787
# FAL_MODEL=fal-ai/qwen-image-edit-2511-multiple-angles
# HF_SPACE=multimodalart/qwen-image-multiple-angles-3d-camera

# Model settings (see README "Model settings that matter"). Defaults follow the LoRA card and the endpoint schema.
# SNAP_POSES=0            # 1 (default) snaps every request to the LoRA's 96 trained poses: 45° azimuths,
#                         # elevations -30/0/30/60, distances close-up/medium/wide.
# LORA_SCALE=1            # fal camera-LoRA strength, 0.8-1.0 recommended; lower keeps the product closer to the photo.
# FAL_IMAGE_SIZE=square_hd  # 1 MP output = training size and the $0.035 price unit (portrait_4_3, landscape_4_3, ... also exist).
# FAL_STEPS=28            # denoising steps (endpoint default 28).
# FAL_GUIDANCE=4.5        # CFG (endpoint default 4.5). Below ~2 the negative prompt stops mattering.
# LOCAL_STEPS=4           # 4 = turbo (Lightning LoRA, CFG 1). 20+ = full model at CFG ~4: slower, sharper fine print.
# LOCAL_CFG=4             # only used with LOCAL_STEPS > 8; the negative prompt is ignored at CFG 1.
# LOCAL_LORA=0.9          # local angles-LoRA strength, 0.8-1.0.
# LOCAL_MEGAPIXELS=1.0    # 1.0 is the training size; 0.6 (small machines) softens small text.
# FAL_CANDIDATES=1        # 2-4 samples per view in one fal call, then the server keeps the one that retained the most of
#                         # the reference photo's wording (Florence OCR, free). Fixes blank-label one-offs; multiplies cost.
